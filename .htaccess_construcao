# MZB Brasil - Configuração de Página em Construção
# Este arquivo prioriza o index.html e redireciona tráfego para a página de aviso.

# 1. Definir o arquivo de índice principal
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Forçar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Redirecionar acessos para a página em construção (index.html)
    # Ignora se for o próprio index.html, a pasta de assets (logo/imagens) ou arquivos físicos reais
    RewriteCond %{REQUEST_URI} !^/index\.html$
    RewriteCond %{REQUEST_URI} !^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /index.html [L,R=302]

    # Caso queira permitir acesso a algum arquivo específico para testes (ex: index.php), 
    # você pode adicionar uma exceção como esta:
    # RewriteCond %{REQUEST_URI} !^/index\.php$
</IfModule>

# 4. Otimização de Cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Compressão Gzip (Performance)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

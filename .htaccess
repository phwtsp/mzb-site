<IfModule mod_rewrite.c>
    RewriteEngine On

	# Forçar HTTPS (Se usar Cloudflare Modo Flexível/Proxied, use a linha X-Forwarded-Proto no lugar da %{HTTPS} off)
    RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
	
    # Nao redirecionar endpoint de envio para evitar quebra em POST
    RewriteRule ^send-email\.php$ - [L]

    # URL canonica da home na raiz
    RewriteRule ^index\.php$ / [R=301,L]

    # Forca URLs limpas quando requisitado .php diretamente
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]|$) [NC]
    RewriteCond %1 !^index$ [NC]
    RewriteCond %1 !^send-email$ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Mantem URLs legadas .html funcionando via URL limpa
    RewriteRule ^(.+)\.html$ /$1 [R=301,L,NC]

    # Remove barra final para evitar duplicidade (exceto raiz e diretorios reais)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Permite acesso sem extensao quando existir arquivo .php correspondente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 3 months"
    ExpiresByType image/png "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType image/webp "access plus 3 months"
    ExpiresByType image/avif "access plus 3 months"
    ExpiresDefault "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
